+
+// Runs a network converted to Core ML by LeelaBench's tools/lc0_to_coreml.py.
+//
+// The model directory holds model.mlmodelc (one function per batch size,
+// "b1", "b8", ...) and lc0coreml.json (input/output names and the network
+// format). No lc0 weights file is loaded: use --weights= (empty).
+//
+// Backend options:
+//   model='<dir>'   the converted model directory (required)
+//   units=all|ne|gpu|cpu   Core ML compute units (default all)
+//   batch=N         only use the batch-size-N function (pads smaller batches)
+//   dump='<file>'   append the first dump_max (default 4096) evaluated inputs to
+//                   <file> as raw float32 [n, 112, 8, 8], e.g. to calibrate or
+//                   check a converted model on real positions
+
+#import <CoreML/CoreML.h>
+#import <Foundation/Foundation.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "neural/factory.h"
+#include "neural/network.h"
+#include "utils/exception.h"
+#include "utils/fp16_utils.h"
+#include "utils/logging.h"
+
+namespace lczero {
+namespace coreml_backend {
+namespace {
+
+constexpr int kNumOutputPolicy = 1858;
+
+class CoreMLNetwork;
+
+class CoreMLComputation : public NetworkComputation {
+ public:
+  explicit CoreMLComputation(CoreMLNetwork* network) : network_(network) {}
+
+  void AddInput(InputPlanes&& input) override { inputs_.emplace_back(std::move(input)); }
+  void ComputeBlocking() override;
+  int GetBatchSize() const override { return static_cast<int>(inputs_.size()); }
+
+  float GetQVal(int sample) const override {
+    if (!wdl_.empty()) return wdl_[sample * 3 + 0] - wdl_[sample * 3 + 2];
+    return value_[sample];
+  }
+  float GetDVal(int sample) const override {
+    return wdl_.empty() ? 0.0f : wdl_[sample * 3 + 1];
+  }
+  float GetPVal(int sample, int move_id) const override {
+    return policy_[sample * kNumOutputPolicy + move_id];
+  }
+  float GetMVal(int sample) const override {
+    return mlh_.empty() ? 0.0f : mlh_[sample];
+  }
+
+ private:
+  CoreMLNetwork* network_;
+  std::vector<InputPlanes> inputs_;
+  std::vector<float> policy_, wdl_, value_, mlh_;
+
+  friend class CoreMLNetwork;
+};
+
+class CoreMLNetwork : public Network {
+ public:
+  explicit CoreMLNetwork(const OptionsDict& options) {
+    @autoreleasepool {
+      const std::string dir = options.Get<std::string>("model");
+      NSString* dirPath = [NSString stringWithUTF8String:dir.c_str()];
+      model_url_ = [NSURL fileURLWithPath:[dirPath stringByAppendingPathComponent:@"model.mlmodelc"]];
+
+      NSData* json = [NSData dataWithContentsOfFile:[dirPath stringByAppendingPathComponent:@"lc0coreml.json"]];
+      if (!json) throw Exception("coreml: no lc0coreml.json in " + dir);
+      NSDictionary* meta = [NSJSONSerialization JSONObjectWithData:json options:0 error:nil];
+      if (![meta isKindOfClass:[NSDictionary class]]) throw Exception("coreml: bad lc0coreml.json");
+
+      input_name_ = meta[@"input"];
+      NSDictionary* outputs = meta[@"outputs"];
+      policy_name_ = outputs[@"policy"];
+      wdl_name_ = outputs[@"wdl"];
+      value_name_ = outputs[@"value"];
+      mlh_name_ = outputs[@"mlh"];
+      if (!input_name_ || !policy_name_ || (!wdl_name_ && !value_name_)) {
+        throw Exception("coreml: lc0coreml.json is missing input/output names");
+      }
+      for (NSNumber* b in meta[@"batch_sizes"]) batch_sizes_.push_back(b.intValue);
+      std::sort(batch_sizes_.begin(), batch_sizes_.end());
+      if (batch_sizes_.empty()) throw Exception("coreml: no batch sizes in model");
+
+      NSDictionary* format = meta[@"format"];
+      capabilities_.input_format = static_cast<pblczero::NetworkFormat::InputFormat>(
+          [format[@"input"] intValue]);
+      capabilities_.output_format = wdl_name_ ? pblczero::NetworkFormat::OUTPUT_WDL
+                                              : pblczero::NetworkFormat::OUTPUT_CLASSICAL;
+      capabilities_.moves_left = mlh_name_
+          ? static_cast<pblczero::NetworkFormat::MovesLeftFormat>([format[@"moves_left"] intValue])
+          : pblczero::NetworkFormat::MOVES_LEFT_NONE;
+      if (mlh_name_ && capabilities_.moves_left == pblczero::NetworkFormat::MOVES_LEFT_NONE) {
+        capabilities_.moves_left = pblczero::NetworkFormat::MOVES_LEFT_V1;
+      }
+
+      const std::string units = options.GetOrDefault<std::string>("units", "all");
+      if (units == "all") compute_units_ = MLComputeUnitsAll;
+      else if (units == "ne") compute_units_ = MLComputeUnitsCPUAndNeuralEngine;
+      else if (units == "gpu") compute_units_ = MLComputeUnitsCPUAndGPU;
+      else if (units == "cpu") compute_units_ = MLComputeUnitsCPUOnly;
+      else throw Exception("coreml: units must be all, ne, gpu or cpu");
+
+      const std::string dump = options.GetOrDefault<std::string>("dump", "");
+      dump_left_ = options.GetOrDefault<int>("dump_max", 4096);
+      if (!dump.empty()) {
+        dump_ = std::fopen(dump.c_str(), "ab");
+        if (!dump_) throw Exception("coreml: can't open dump file " + dump);
+      }
+
+      forced_batch_ = options.GetOrDefault<int>("batch", 0);
+      if (forced_batch_ > 0 &&
+          std::find(batch_sizes_.begin(), batch_sizes_.end(), forced_batch_) == batch_sizes_.end()) {
+        std::string list;
+        for (int b : batch_sizes_) list += (list.empty() ? "" : ", ") + std::to_string(b);
+        throw Exception("coreml: batch=" + std::to_string(forced_batch_) +
+                        " is not in this model (has " + list + ")");
+      }
+
+      CERR << "Core ML model: " << [meta[@"name"] UTF8String] << ", units " << units
+           << ", batch sizes " << batch_sizes_.front() << ".." << batch_sizes_.back()
+           << (forced_batch_ > 0 ? ", fixed batch " + std::to_string(forced_batch_) : "");
+      usable_ = batch_sizes_;
+      if (forced_batch_ > 0) {
+        // Load (and let Core ML prepare) the function now, so its cost isn't
+        // counted in the first timed batch.
+        Model(forced_batch_);
+      } else {
+        // Auto: start from a moderate size. Big sizes of big nets can fail to
+        // compile for the Neural Engine, so they're only loaded when needed.
+        auto it = std::upper_bound(usable_.begin(), usable_.end(), 16);
+        preferred_ = it == usable_.begin() ? usable_.front() : *std::prev(it);
+        while (!TryModel(preferred_)) preferred_ = usable_.front();
+      }
+    }
+  }
+
+  ~CoreMLNetwork() override {
+    if (dump_) std::fclose(dump_);
+  }
+
+  const NetworkCapabilities& GetCapabilities() const override { return capabilities_; }
+
+  std::unique_ptr<NetworkComputation> NewComputation() override {
+    return std::make_unique<CoreMLComputation>(this);
+  }
+
+  int GetMiniBatchSize() const override {
+    return forced_batch_ > 0 ? forced_batch_ : preferred_;
+  }
+
+  // Batch size for the next call with `n` positions left: the smallest usable
+  // size that fits them all, else the largest usable size.
+  int NextSize(int n) const {
+    if (forced_batch_ > 0) return forced_batch_;
+    auto it = std::lower_bound(usable_.begin(), usable_.end(), n);
+    return it == usable_.end() ? usable_.back() : *it;
+  }
+
+  void Compute(CoreMLComputation* c) {
+    const int n = static_cast<int>(c->inputs_.size());
+    c->policy_.assign(n * kNumOutputPolicy, 0.0f);
+    if (wdl_name_) c->wdl_.assign(n * 3, 0.0f); else c->value_.assign(n, 0.0f);
+    if (mlh_name_) c->mlh_.assign(n, 0.0f);
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    int start = 0;
+    while (start < n) {
+      const int size = NextSize(n - start);
+      MLModel* model = forced_batch_ > 0 ? Model(size) : TryModel(size);
+      if (!model) continue;  // TryModel dropped this size; plan again.
+      const int count = std::min(size, n - start);
+      @autoreleasepool {
+        RunBatch(model, c, start, count, size);
+      }
+      start += count;
+    }
+  }
+
+ private:
+  // Loads the function for `batch`, or returns nil and sets `error`.
+  MLModel* Load(int batch, std::string* error_text) {
+    auto it = models_.find(batch);
+    if (it != models_.end()) return it->second;
+    if (@available(iOS 18.0, macOS 15.0, *)) {
+      MLModelConfiguration* config = [[MLModelConfiguration alloc] init];
+      config.computeUnits = compute_units_;
+      config.functionName = [NSString stringWithFormat:@"b%d", batch];
+      NSError* error = nil;
+      MLModel* model = [MLModel modelWithContentsOfURL:model_url_ configuration:config error:&error];
+      if (!model) {
+        *error_text = error ? std::string(error.localizedDescription.UTF8String) : "unknown error";
+        return nil;
+      }
+      models_[batch] = model;
+      return model;
+    }
+    *error_text = "needs iOS 18 / macOS 15";
+    return nil;
+  }
+
+  // A batch size the user picked: failing to load it is an error.
+  MLModel* Model(int batch) {
+    std::string error;
+    MLModel* model = Load(batch, &error);
+    if (!model) {
+      throw Exception("coreml: batch " + std::to_string(batch) +
+                      " failed to load on this device (Core ML couldn't compile it for these "
+                      "compute units; try a smaller batch). Core ML said: " + error);
+    }
+    return model;
+  }
+
+  // Auto mode: a size that fails to load is dropped and smaller ones are used.
+  MLModel* TryModel(int batch) {
+    std::string error;
+    if (MLModel* model = Load(batch, &error)) return model;
+    usable_.erase(std::remove(usable_.begin(), usable_.end(), batch), usable_.end());
+    CERR << "Core ML: batch " << batch << " can't be loaded on this device ("
+         << error << "); using the other batch sizes.";
+    if (usable_.empty()) throw Exception("coreml: no batch size of this model loads on this device");
+    return nil;
+  }
+
+  void RunBatch(MLModel* model, CoreMLComputation* c, int start, int count, int size) {
+    // Expand the bit-packed planes to [size, 112, 8, 8] floats; padding stays 0.
+    std::vector<float> input(static_cast<size_t>(size) * kInputPlanes * 64, 0.0f);
+    for (int i = 0; i < count; i++) {
+      const InputPlanes& planes = c->inputs_[start + i];
+      float* dst = input.data() + static_cast<size_t>(i) * kInputPlanes * 64;
+      for (int p = 0; p < kInputPlanes; p++) {
+        uint64_t mask = planes[p].mask;
+        while (mask) {
+          const int sq = __builtin_ctzll(mask);
+          dst[p * 64 + sq] = planes[p].value;
+          mask &= mask - 1;
+        }
+      }
+    }
+
+    if (dump_ && dump_left_ > 0) {
+      const int n = std::min(count, dump_left_);
+      std::fwrite(input.data(), sizeof(float), static_cast<size_t>(n) * kInputPlanes * 64, dump_);
+      dump_left_ -= n;
+      if (dump_left_ == 0) std::fflush(dump_);
+    }
+
+    NSError* error = nil;
+    MLMultiArray* array = [[MLMultiArray alloc]
+        initWithDataPointer:input.data()
+                      shape:@[@(size), @(kInputPlanes), @8, @8]
+                   dataType:MLMultiArrayDataTypeFloat32
+                    strides:@[@(kInputPlanes * 64), @64, @8, @1]
+                deallocator:nil
+                      error:&error];
+    if (!array) throw Exception("coreml: can't wrap input");
+    MLDictionaryFeatureProvider* features = [[MLDictionaryFeatureProvider alloc]
+        initWithDictionary:@{input_name_ : [MLFeatureValue featureValueWithMultiArray:array]}
+                     error:&error];
+    id<MLFeatureProvider> result = [model predictionFromFeatures:features error:&error];
+    if (!result) {
+      throw Exception("coreml: prediction failed: " +
+                      std::string(error.localizedDescription.UTF8String));
+    }
+
+    Copy(result, policy_name_, count, kNumOutputPolicy, c->policy_.data() + start * kNumOutputPolicy);
+    if (wdl_name_) Copy(result, wdl_name_, count, 3, c->wdl_.data() + start * 3);
+    else Copy(result, value_name_, count, 1, c->value_.data() + start);
+    if (mlh_name_) Copy(result, mlh_name_, count, 1, c->mlh_.data() + start);
+  }
+
+  // Copies the first `count` rows of a [batch, width] output.
+  static void Copy(id<MLFeatureProvider> result, NSString* name, int count, int width, float* dst) {
+    MLMultiArray* out = [result featureValueForName:name].multiArrayValue;
+    if (!out) throw Exception("coreml: missing output " + std::string(name.UTF8String));
+    const NSInteger row = out.strides[0].integerValue;
+    const NSInteger col = out.strides[out.strides.count - 1].integerValue;
+    __block bool copied = false;
+    [out getBytesWithHandler:^(const void* bytes, NSInteger) {
+      for (int i = 0; i < count; i++) {
+        for (int j = 0; j < width; j++) {
+          const NSInteger idx = i * row + j * col;
+          switch (out.dataType) {
+            case MLMultiArrayDataTypeFloat32:
+              dst[i * width + j] = static_cast<const float*>(bytes)[idx];
+              break;
+            case MLMultiArrayDataTypeFloat16:
+              dst[i * width + j] = FP16toFP32(static_cast<const uint16_t*>(bytes)[idx]);
+              break;
+            case MLMultiArrayDataTypeDouble:
+              dst[i * width + j] = static_cast<float>(static_cast<const double*>(bytes)[idx]);
+              break;
+            default:
+              return;
+          }
+        }
+      }
+      copied = true;
+    }];
+    if (!copied) throw Exception("coreml: unsupported output type for " + std::string(name.UTF8String));
+  }
+
+  NSURL* model_url_;
+  NSString* input_name_;
+  NSString* policy_name_;
+  NSString* wdl_name_;
+  NSString* value_name_;
+  NSString* mlh_name_;
+  std::vector<int> batch_sizes_;
+  std::vector<int> usable_;  // batch_sizes_ minus those that failed to load
+  int preferred_ = 16;
+  int forced_batch_ = 0;
+  MLComputeUnits compute_units_ = MLComputeUnitsAll;
+  NetworkCapabilities capabilities_;
+  std::map<int, MLModel*> models_;
+  std::mutex mutex_;
+  std::FILE* dump_ = nullptr;
+  int dump_left_ = 0;
+};
+
+void CoreMLComputation::ComputeBlocking() { network_->Compute(this); }
+
+std::unique_ptr<Network> MakeCoreMLNetwork(const std::optional<WeightsFile>& /*weights*/,
+                                           const OptionsDict& options) {
+  return std::make_unique<CoreMLNetwork>(options);
+}
+
+}  // namespace
+
+REGISTER_NETWORK("coreml", MakeCoreMLNetwork, 58)
+
+}  // namespace coreml_backend
+}  // namespace lczero
